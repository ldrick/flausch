# Android SDK versions for CI, the Makefile and the F-Droid recipe (a test keeps the recipe and targetSdk in
# Cargo.toml in sync). .github/workflows/android-sdk.yml opens an issue when newer stable versions exist.
ANDROID_PLATFORM=android-36
ANDROID_BUILD_TOOLS_VERSION=36.0.0
ANDROID_NDK_VERSION=30.0.16248370
