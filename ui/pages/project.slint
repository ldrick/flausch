import { Theme } from "../theme.slint";
import { Store, DialogKind, PartItem } from "../store.slint";
import { Card, Icon, IconButton, PillButton, ButtonKind, ProgressBar, TopBar } from "../components.slint";

export component PatternCard inherits Card {
    // Shows a button to remove the PDF from the project.
    in property <bool> removable: true;

    height: 72px;
    background: touch.pressed ? Theme.surface-muted : Theme.surface;
    accessible-role: button;
    accessible-label: @tr("Open pattern");
    accessible-action-default => { Store.open-pdf(); }

    touch := TouchArea {
        clicked => { Store.open-pdf(); }
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 6px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 40px;
                height: 40px;
                border-radius: Theme.radius-small;
                background: Theme.accent-soft;

                Icon {
                    source: @image-url("../icons/file.svg");
                    color: Theme.accent-pressed;
                    width: 20px;
                    height: 20px;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: @tr("Pattern");
                color: Theme.text-muted;
                font-size: Theme.font-small;
            }
            Text {
                text: Store.current.pdf-title;
                color: Theme.text;
                font-size: Theme.font-body;
                overflow: elide;
            }
        }
        if root.removable: VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("../icons/close.svg");
                tint: Theme.text-muted;
                label: @tr("Remove pattern");
                clicked => { Store.dialog = DialogKind.remove-pdf; }
            }
        }
    }
}

component SectionTitle inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-small;
    font-weight: 600;
}

component PartCard inherits Card {
    in property <PartItem> part;
    in property <bool> active;
    callback clicked();

    height: root.part.goal > 0 ? 84px : 68px;
    background: touch.pressed ? Theme.surface-muted : Theme.surface;
    border-width: root.active ? 1.5px : 0;
    border-color: Theme.accent;
    accessible-role: button;
    accessible-label: root.part.goal > 0 ? @tr("{}, row {} of {}", root.part.name, root.part.row, root.part.goal) : @tr("{}, row {}", root.part.name, root.part.row);
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 12px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;
            spacing: 10px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 8px;

                Text {
                    text: root.part.name;
                    color: Theme.text;
                    font-size: Theme.font-body + 1px;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.part.goal > 0 ? @tr("Row {} of {}", root.part.row, root.part.goal) : @tr("Row {}", root.part.row);
                    color: Theme.text-muted;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }
            }
            if root.part.goal > 0: ProgressBar {
                progress: root.part.row / root.part.goal;
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("../icons/chevron-right.svg");
                color: Theme.border;
                width: 20px;
                height: 20px;
            }
        }
    }
}

export component ProjectPage inherits Rectangle {
    VerticalLayout {
        TopBar {
            title: Store.current.name;
            back => { Store.back(); }

            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("../icons/edit.svg");
                    label: @tr("Rename project");
                    clicked => { Store.dialog = DialogKind.edit; }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("../icons/trash.svg");
                    label: @tr("Delete project");
                    clicked => { Store.dialog = DialogKind.delete; }
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;

            content := VerticalLayout {
                padding: Theme.padding;
                padding-top: 8px;
                spacing: Theme.spacing;
                alignment: start;

                SectionTitle {
                    text: @tr("Parts");
                }
                if Store.parts.length == 0: Text {
                    text: @tr("Add the parts of your project, e.g. head, body and legs. Each part counts its own rows.");
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
                for part in Store.parts: PartCard {
                    part: part;
                    active: Store.current.has-active && part.id == Store.current.active.id;
                    clicked => { Store.open-part(part.id); }
                }
                PillButton {
                    kind: Store.parts.length == 0 ? ButtonKind.primary : ButtonKind.secondary;
                    text: @tr("Add part");
                    icon: @image-url("../icons/plus.svg");
                    has-icon: true;
                    clicked => { Store.dialog = DialogKind.add-part; }
                }

                Rectangle {
                    height: 8px;
                }
                SectionTitle {
                    text: @tr("Pattern");
                }
                if !Store.current.has-pdf: PillButton {
                    kind: ButtonKind.secondary;
                    text: @tr("Add PDF pattern");
                    icon: @image-url("../icons/file.svg");
                    has-icon: true;
                    clicked => { Store.pick-pdf(); }
                }
                if Store.current.has-pdf: PatternCard { }
            }
        }
    }
}
