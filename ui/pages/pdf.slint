import { Theme } from "../theme.slint";
import { Store, DialogKind, Screen } from "../store.slint";
import { Icon, IconButton, TopBar } from "../components.slint";
import { CounterButtons, NextPieceButton, RowCount } from "../counter.slint";

component FloatingPill inherits Rectangle {
    height: 56px;
    width: layout.preferred-width;
    border-radius: self.height / 2;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-offset-y: Theme.shadow-offset;
    drop-shadow-color: Theme.shadow;

    layout := HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        @children
    }
}

// Large counter, like on the part screen. Below the page in portrait, beside it in landscape, so the
// page stays readable.
component LargeCounter inherits Rectangle {
    in property <bool> side;

    vertical-stretch: 0;
    background: Theme.surface;

    // Square, because the page ends straight next to it; a line instead of a shadow sets it apart
    // from the (usually white) page.
    Rectangle {
        x: 0;
        y: 0;
        width: root.side ? 1px : parent.width;
        height: root.side ? parent.height : 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding: 12px;
        padding-bottom: root.side ? 12px : 28px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 4px;

            Rectangle {
                horizontal-stretch: 0;
                border-radius: 24px;
                background: pick-touch.pressed ? Theme.surface-muted : transparent;
                accessible-role: button;
                accessible-enabled: Store.parts.length > 1;
                accessible-label: Store.parts.length > 1 ? @tr("Choose part") : Store.part.title;
                accessible-action-default => { Store.dialog = DialogKind.pick-part; }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 4px;
                    Text {
                        text: Store.part.title;
                        color: Theme.text;
                        font-size: Theme.font-body;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if Store.parts.length > 1: VerticalLayout {
                        alignment: center;
                        Icon {
                            source: @image-url("../icons/chevron-down.svg");
                            color: Theme.text-muted;
                            width: 18px;
                            height: 18px;
                        }
                    }
                }
                pick-touch := TouchArea {
                    enabled: Store.parts.length > 1;
                    clicked => { Store.dialog = DialogKind.pick-part; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            IconButton {
                icon: @image-url("../icons/minimize.svg");
                label: @tr("Shrink counter");
                clicked => { Store.counter-expanded = false; }
            }
        }

        if root.side: Rectangle {
            vertical-stretch: 1;
        }

        RowCount {
            vertical-stretch: 0;
            number-size: root.side ? 64px : 80px;
            inset: 0;
        }

        CounterButtons {
            padding-top: 12px;
            size: root.side ? 52px : 56px;
            primary-size: root.side ? 72px : 84px;
        }

        if Store.part.can-next-piece: VerticalLayout {
            padding-top: 12px;
            NextPieceButton { }
        }

        if root.side: Rectangle {
            vertical-stretch: 1;
        }
    }
}

// An entry of the top bar menu. Zoom stays open after a tap, so it can be repeated.
component MenuItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: Theme.touch + 4px;
    border-radius: Theme.radius-small - 4px;
    background: touch.pressed ? Theme.surface-muted : transparent;
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: 22px;
                height: 22px;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

export component PdfPage inherits Rectangle {
    property <float> zoom: Store.pdf.zoom;
    property <float> start-zoom;
    property <length> start-x;
    property <length> start-y;
    property <bool> restored: false;
    property <length> page-height: flick.width * root.zoom * Store.pdf.aspect;
    // Top of the page within the visible area.
    property <length> page-top: page.y + flick.content-y;
    // Horizontal offset of the page while it slides out after a swipe and the next one slides in.
    property <length> slide;
    property <bool> slide-animated;
    animate slide {
        duration: root.slide-animated ? 180ms : 0ms;
        easing: ease-out;
    }
    // Direction of the page turn waiting for its image: 1 next, -1 previous, 0 none.
    property <int> turning;

    // Moves the page to `from` at once, then animates it to `to`.
    function slide-page(from: length, to: length) {
        root.slide-animated = false;
        root.slide = from;
        root.slide-animated = true;
        root.slide = to;
    }

    // Offset of the reading line while it is being dragged.
    property <length> line-drag;

    function scroll-fraction(offset: length, range: length) -> float {
        return range > 0 ? clamp(-offset / range, 0, 1) : 0;
    }

    function report() {
        Store.pdf-view-changed(Store.pdf.page, root.zoom,
            scroll-fraction(flick.content-x, flick.content-width - flick.width),
            scroll-fraction(flick.content-y, flick.content-height - flick.height),
            flick.width / 1phx);
    }

    // Zooms to `new-zoom`, keeping the point (cx, cy) of the visible area in place.
    function zoom-to(new-zoom: float, cx: length, cy: length) {
        set-zoom(root.zoom, flick.content-x, flick.content-y, new-zoom, cx, cy);
        report();
    }

    function set-zoom(from-zoom: float, from-x: length, from-y: length, new-zoom: float, cx: length, cy: length) {
        root.zoom = clamp(new-zoom, 1, 4);
        let ratio = root.zoom / from-zoom;
        flick.content-x = clamp(cx - (cx - from-x) * ratio, min(0, flick.width - flick.content-width), 0);
        flick.content-y = clamp(cy - (cy - from-y) * ratio, min(0, flick.height - flick.content-height), 0);
    }

    function go-to-page(page: int) {
        flick.content-x = 0;
        flick.content-y = 0;
        Store.pdf-view-changed(page, root.zoom, 0, 0, flick.width / 1phx);
        // Each page keeps its own line; a page without one gets it in the middle of the view.
        if Store.pdf.line-visible && !Store.pdf.line-saved {
            Store.pdf-line-moved(visible-center());
        }
    }

    // Position on the page (fraction of its height) that is in the middle of the visible area.
    function visible-center() -> float {
        return root.page-height > 0 ? clamp((flick.height / 2 - root.page-top) / root.page-height, 0, 1) : 0.5;
    }

    init => {
        report();
    }
    // Restore the saved scroll position once the first page has been rendered.
    // The next page slides in once its image is there, or when rendering failed.
    property <bool> loading: Store.pdf.loading;
    changed loading => {
        if !root.loading && root.turning != 0 {
            root.slide-page(root.turning * flick.width, 0);
            root.turning = 0;
        }
    }
    changed serial => {
        if !root.restored {
            root.restored = true;
            flick.content-x = -Store.pdf.scroll-x * max(0, flick.content-width - flick.width);
            flick.content-y = -Store.pdf.scroll-y * max(0, flick.content-height - flick.height);
        }
    }
    property <int> serial: Store.pdf.serial;

    property <bool> expanded: Store.counter-expanded && Store.current.has-active;
    property <bool> landscape: root.width > root.height;

    HorizontalLayout {
        VerticalLayout {
            TopBar {
                title: Store.current.pdf-title;
                back => { Store.back(); }

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("../icons/reading-line.svg");
                        label: Store.pdf.line-visible ? @tr("Hide reading line") : @tr("Show reading line");
                        tint: Store.pdf.line-visible ? Theme.line-color(Store.line-color) : Theme.text;
                        clicked => { Store.pdf-line-shown(!Store.pdf.line-visible, root.visible-center()); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: @image-url("../icons/more.svg");
                        label: @tr("More options");
                        clicked => { Store.pdf-menu-open = true; }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                clip: true;

                gesture := ScaleRotateGestureHandler {
                    started => {
                        root.start-zoom = root.zoom;
                        root.start-x = flick.content-x;
                        root.start-y = flick.content-y;
                    }
                    updated => {
                        root.set-zoom(root.start-zoom, root.start-x, root.start-y, root.start-zoom * self.scale, self.center.x, self.center.y);
                    }
                    ended => { root.report(); }

                    // At zoom 1 the page fits the width, so a horizontal swipe turns the page.
                    swipe := SwipeGestureHandler {
                        enabled: root.zoom < 1.01 && Store.pdf.page-count > 1;
                        handle-swipe-left: Store.pdf.page + 1 < Store.pdf.page-count;
                        handle-swipe-right: Store.pdf.page > 0;
                        swiped => {
                            let dx = self.current-position.x - self.pressed-position.x;
                            let dy = self.current-position.y - self.pressed-position.y;
                            if abs(dx) > 60px && abs(dx) > abs(dy) {
                                let direction = dx < 0 ? 1 : -1;
                                root.go-to-page(Store.pdf.page + direction);
                                root.turning = direction;
                                root.slide-page(dx, -direction * flick.width);
                            } else {
                                root.slide-page(dx, 0);
                            }
                        }
                        cancelled => { root.slide-page(0, 0); }

                        flick := Flickable {
                            content-width: self.width * root.zoom;
                            // Extra room at the bottom so the floating controls never cover the page end.
                            content-height: max(self.height, root.page-height + 96px);
                            flicked => { root.report(); }
                            // Also when the large counter opens beside the page in landscape.
                            changed width => { root.report(); }

                            page := Rectangle {
                                // Follows the finger while swiping.
                                x: swipe.swiping ? swipe.current-position.x - swipe.pressed-position.x : root.slide;
                                y: max(0, (flick.height - 96px - root.page-height) / 2);
                                width: flick.content-width;
                                height: root.page-height;
                                background: #ffffff;

                                Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: Store.pdf.image;
                                    image-fit: fill;
                                    accessible-role: image;
                                    accessible-label: @tr("Page {} of {}", Store.pdf.page + 1, Store.pdf.page-count);
                                }
                                // Double tap zooms. Detected by hand, since the swipe handler delays the
                                // events and `double-clicked` then never fires.
                                TouchArea {
                                    property <duration> last-tap: -1s;
                                    property <length> last-x;
                                    property <length> last-y;
                                    clicked => {
                                        let now = animation-tick();
                                        if now - self.last-tap < 400ms && abs(self.mouse-x - self.last-x) < 40px && abs(self.mouse-y - self.last-y) < 40px {
                                            self.last-tap = -1s;
                                            if root.zoom > 1.01 {
                                                root.zoom-to(1, 0, 0);
                                            } else {
                                                root.zoom-to(2.5, self.mouse-x + flick.content-x, self.mouse-y + parent.y + flick.content-y);
                                            }
                                        } else {
                                            self.last-tap = now;
                                            self.last-x = self.mouse-x;
                                            self.last-y = self.mouse-y;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if Store.pdf.loading && Store.pdf.serial == 0: Text {
                    text: @tr("Loading…");
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                }

                // Reading line: sits on the page and scrolls with it; dragged by the grip on the right.
                if Store.pdf.line-visible && Store.pdf.serial > 0: Rectangle {
                    property <length> line-y: root.page-top + Store.pdf.line * root.page-height + root.line-drag;
                    x: 0;
                    y: self.line-y - self.height / 2;
                    width: parent.width;
                    height: Theme.touch;

                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: Theme.line-width;
                        background: Theme.line-color(Store.line-color);
                    }
                    Rectangle {
                        x: parent.width - Theme.touch;
                        width: Theme.touch;
                        accessible-role: slider;
                        accessible-label: @tr("Reading line");
                        accessible-value: round(Store.pdf.line * 100) + "%";
                        accessible-action-increment => { Store.pdf-line-moved(Store.pdf.line + 0.02); }
                        accessible-action-decrement => { Store.pdf-line-moved(Store.pdf.line - 0.02); }

                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: self.height / 2;
                            background: Theme.line-color(Store.line-color);
                            border-width: 2px;
                            border-color: Theme.on-line;

                            VerticalLayout {
                                alignment: center;
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 3px;
                                for _ in 2: Rectangle {
                                    height: 2px;
                                    border-radius: 1px;
                                    background: Theme.on-line;
                                }
                            }
                        }
                        grip := TouchArea {
                            moved => {
                                root.line-drag = clamp(root.line-drag + self.mouse-y - self.pressed-y,
                                    -Store.pdf.line * root.page-height, (1 - Store.pdf.line) * root.page-height);
                            }
                            pointer-event(event) => {
                                if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                                    if root.page-height > 0 && root.line-drag != 0 {
                                        Store.pdf-line-moved(Store.pdf.line + root.line-drag / root.page-height);
                                    }
                                    root.line-drag = 0;
                                }
                            }
                        }
                    }
                }

                // Page navigation
                FloatingPill {
                    x: 12px;
                    y: parent.height - self.height - 16px;
                    visible: Store.pdf.page-count > 1;

                    IconButton {
                        y: 4px;
                        icon: @image-url("../icons/chevron-left.svg");
                        label: @tr("Previous page");
                        enabled: Store.pdf.page > 0;
                        clicked => { root.go-to-page(Store.pdf.page - 1); }
                    }
                    Text {
                        text: "\{Store.pdf.page + 1}/\{Store.pdf.page-count}";
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        min-width: 36px;
                        horizontal-alignment: center;
                    }
                    IconButton {
                        y: 4px;
                        icon: @image-url("../icons/chevron-right.svg");
                        label: @tr("Next page");
                        enabled: Store.pdf.page + 1 < Store.pdf.page-count;
                        clicked => { root.go-to-page(Store.pdf.page + 1); }
                    }
                }

                if !Store.current.has-active && Store.parts.length > 0: FloatingPill {
                    x: parent.width - self.width - 12px;
                    y: parent.height - self.height - 16px;

                    Rectangle {
                        border-radius: 24px;
                        background: choose-touch.pressed ? Theme.surface-muted : transparent;
                        accessible-role: button;
                        accessible-label: @tr("Choose part");
                        accessible-action-default => { Store.dialog = DialogKind.pick-part; }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 4px;
                            Text {
                                text: @tr("Choose part");
                                color: Theme.text;
                                font-size: Theme.font-body;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: @image-url("../icons/chevron-down.svg");
                                    color: Theme.text-muted;
                                    width: 18px;
                                    height: 18px;
                                }
                            }
                        }
                        choose-touch := TouchArea {
                            clicked => { Store.dialog = DialogKind.pick-part; }
                        }
                    }
                }

                // Row counter, always at hand while reading the pattern.
                if Store.current.has-active && !Store.counter-expanded: FloatingPill {
                    x: parent.width - self.width - 12px;
                    y: parent.height - self.height - 16px;

                    IconButton {
                        y: 4px;
                        icon: @image-url("../icons/minus.svg");
                        label: @tr("Previous row");
                        enabled: Store.part.row > 0 || Store.part.piece > 1;
                        clicked => { Store.decrement(); }
                    }
                    // Tap to enlarge the counter.
                    Rectangle {
                        min-width: 72px;
                        max-width: 150px;
                        border-radius: 12px;
                        background: expand-touch.pressed ? Theme.surface-muted : transparent;
                        accessible-role: button;
                        accessible-label: @tr("Enlarge counter");
                        accessible-action-default => { Store.counter-expanded = true; }

                        VerticalLayout {
                            alignment: center;
                            padding-left: 4px;
                            padding-right: 4px;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: Store.part.title;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-small;
                                    overflow: elide;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: @image-url("../icons/chevron-up.svg");
                                        color: Theme.text-muted;
                                        width: 14px;
                                        height: 14px;
                                    }
                                }
                            }
                            Text {
                                text: @tr("Row {}", Store.part.row);
                                color: Theme.text;
                                font-size: Theme.font-body;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                        }
                        expand-touch := TouchArea {
                            clicked => { Store.counter-expanded = true; }
                        }
                    }
                    Rectangle {
                        width: 48px;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: self.height / 2;
                            background: plus-touch.pressed ? Theme.accent-pressed : Theme.accent;
                            accessible-role: button;
                            accessible-label: @tr("Next row");
                            accessible-action-default => { Store.increment(); }

                            Image {
                                source: @image-url("../icons/plus.svg");
                                colorize: Theme.on-accent;
                                width: 22px;
                                height: 22px;
                            }
                            plus-touch := TouchArea {
                                clicked => { Store.increment(); }
                            }
                        }
                    }
                }
            }

            if root.expanded && !root.landscape: LargeCounter { }
        }
        if root.expanded && root.landscape: LargeCounter {
            side: true;
            width: 300px;
        }
    }

    // The menu of the top bar, dropping down from its button. A tap outside or Back closes it.
    if Store.pdf-menu-open: TouchArea {
        clicked => { Store.pdf-menu-open = false; }

        Rectangle {
            x: parent.width - self.width - 8px;
            y: 56px;
            width: 240px;
            height: menu.preferred-height;
            background: Theme.surface;
            border-radius: Theme.radius-small;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-offset-y: Theme.shadow-offset-small;
            drop-shadow-color: Theme.shadow;
            // The TalkBack bridge (src/a11y.rs) only exposes what lies inside the menu.
            accessible-role: groupbox;
            accessible-id: "dialog";

            // Swallow taps between the items.
            TouchArea { }

            menu := VerticalLayout {
                padding: 6px;

                MenuItem {
                    icon: @image-url("../icons/book.svg");
                    text: @tr("Abbreviations");
                    clicked => {
                        Store.pdf-menu-open = false;
                        Store.open-page(Screen.abbreviations);
                    }
                }
                MenuItem {
                    icon: @image-url("../icons/zoom-in.svg");
                    text: @tr("Zoom in");
                    enabled: root.zoom < 4;
                    clicked => { root.zoom-to(root.zoom * 1.25, flick.width / 2, flick.height / 2); }
                }
                MenuItem {
                    icon: @image-url("../icons/zoom-out.svg");
                    text: @tr("Zoom out");
                    enabled: root.zoom > 1;
                    clicked => { root.zoom-to(root.zoom / 1.25, flick.width / 2, flick.height / 2); }
                }
            }
        }
    }
}
