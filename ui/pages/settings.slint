import { AboutSlint, Palette } from "std-widgets.slint";
import { Theme, Appearance, LineColor } from "../theme.slint";
import { Store, Language } from "../store.slint";
import { ButtonKind, Card, Icon, PillButton, Segmented, Switch, TopBar } from "../components.slint";

component SectionTitle inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-small;
    font-weight: 600;
}

component ColorSwatch inherits Rectangle {
    in property <LineColor> value;
    in property <string> label;
    in property <bool> selected;
    callback select();

    width: Theme.touch;
    height: Theme.touch;
    border-radius: self.height / 2;
    border-width: root.selected ? 3px : 0;
    border-color: Theme.text;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.selected;
    accessible-action-default => { root.select(); }

    Rectangle {
        width: 34px;
        height: 34px;
        border-radius: self.height / 2;
        background: Theme.line-color(root.value);
    }
    TouchArea {
        clicked => { root.select(); }
    }
}

export component SettingsPage inherits Rectangle {
    VerticalLayout {
        TopBar {
            title: @tr("Settings");
            back => { Store.back(); }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;

            content := VerticalLayout {
                padding: Theme.padding;
                padding-top: 4px;
                spacing: Theme.spacing;
                alignment: start;

                SectionTitle {
                    text: @tr("Language");
                }
                Segmented {
                    options: [{ label: @tr("System") }, { label: "Deutsch" }, { label: "English" }];
                    selected: Store.language == Language.de ? 1 : Store.language == Language.en ? 2 : 0;
                    select(index) => {
                        Store.set-language(index == 1 ? Language.de : index == 2 ? Language.en : Language.system);
                    }
                }

                SectionTitle {
                    text: @tr("Appearance");
                }
                Segmented {
                    options: [{ label: @tr("System") }, { label: @tr("Light") }, { label: @tr("Dark") }];
                    selected: Store.appearance == Appearance.light ? 1 : Store.appearance == Appearance.dark ? 2 : 0;
                    select(index) => {
                        Store.set-appearance(index == 1 ? Appearance.light : index == 2 ? Appearance.dark : Appearance.system);
                    }
                }

                SectionTitle {
                    text: @tr("Counting");
                }
                Card {
                    height: row.preferred-height;

                    row := HorizontalLayout {
                        padding: 18px;
                        spacing: 16px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: @tr("Keep screen on");
                                color: Theme.text;
                                font-size: Theme.font-body;
                            }
                            Text {
                                text: @tr("While a project or pattern is open");
                                color: Theme.text-muted;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Switch {
                                label: @tr("Keep screen on");
                                checked: Store.keep-screen-on;
                                toggled => { Store.set-keep-screen-on(!Store.keep-screen-on); }
                            }
                        }
                    }
                }

                SectionTitle {
                    text: @tr("Pattern");
                }
                Card {
                    height: line.preferred-height;

                    line := VerticalLayout {
                        padding: 18px;
                        spacing: 10px;

                        Text {
                            text: @tr("Reading line color");
                            color: Theme.text;
                            font-size: Theme.font-body;
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            for option in [
                                { value: LineColor.magenta, label: @tr("Magenta") },
                                { value: LineColor.red, label: @tr("Red") },
                                { value: LineColor.orange, label: @tr("Orange") },
                                { value: LineColor.blue, label: @tr("Blue") },
                                { value: LineColor.green, label: @tr("Green") },
                            ]: ColorSwatch {
                                value: option.value;
                                label: option.label;
                                selected: Store.line-color == option.value;
                                select => { Store.set-line-color(option.value); }
                            }
                        }
                    }
                }

                SectionTitle {
                    text: @tr("Data");
                }
                Card {
                    height: data.preferred-height;

                    data := VerticalLayout {
                        padding: 18px;
                        spacing: 14px;

                        Text {
                            text: @tr("Save projects, row counters and patterns as a ZIP file, for example before switching phones.");
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            PillButton {
                                text: @tr("Export");
                                kind: ButtonKind.secondary;
                                horizontal-stretch: 1;
                                enabled: !Store.backup-busy;
                                clicked => { Store.export-backup(); }
                            }
                            PillButton {
                                text: @tr("Import");
                                kind: ButtonKind.secondary;
                                horizontal-stretch: 1;
                                enabled: !Store.backup-busy;
                                clicked => { Store.import-backup(); }
                            }
                        }
                    }
                }

                SectionTitle {
                    text: @tr("About");
                }
                Card {
                    height: about.preferred-height;

                    about := VerticalLayout {
                        padding: 18px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 10px;
                            Icon {
                                source: @image-url("../icons/logo.svg");
                                color: Theme.accent;
                                width: 28px;
                                height: 28px;
                            }
                            Text {
                                text: "Flausch \{Store.version}";
                                color: Theme.text;
                                font-size: Theme.font-body;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: @tr("A crochet companion. Flausch is German for fluff.");
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                        // AboutSlint follows Palette, not Theme, so give it a matching backdrop.
                        Rectangle {
                            height: 120px;
                            background: Palette.background;
                            border-radius: Theme.radius-small;

                            AboutSlint { }
                        }
                    }
                }
            }
        }
    }
}
