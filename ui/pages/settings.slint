import { Theme, Appearance, LineColor } from "../theme.slint";
import { Store, Language, Screen } from "../store.slint";
import { ButtonKind, Card, Divider, NavRow, PillButton, SectionTitle, Segmented, Switch, TopBar } from "../components.slint";

component ColorSwatch inherits Rectangle {
    in property <LineColor> value;
    in property <string> label;
    in property <bool> selected;
    callback select();

    width: Theme.touch;
    height: Theme.touch;
    border-radius: self.height / 2;
    border-width: root.selected ? 3px : 0;
    border-color: Theme.text;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.selected;
    accessible-action-default => { root.select(); }

    Rectangle {
        width: 34px;
        height: 34px;
        border-radius: self.height / 2;
        background: Theme.line-color(root.value);
    }
    TouchArea {
        clicked => { root.select(); }
    }
}

// Keeps the scroll position while a sub-page is open, since the page is rebuilt on return.
global SettingsScroll {
    in-out property <length> y;
}

// A setting that is switched on or off.
component SwitchRow inherits HorizontalLayout {
    in property <string> text;
    in property <string> description;
    in property <bool> checked;
    callback toggled();

    padding: 12px;
    spacing: 16px;

    VerticalLayout {
        alignment: center;
        spacing: 2px;

        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            wrap: word-wrap;
        }
        if root.description != "": Text {
            text: root.description;
            color: Theme.text-muted;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        alignment: center;
        Switch {
            label: root.text;
            checked: root.checked;
            toggled => { root.toggled(); }
        }
    }
}

// A setting with its control below the name, e.g. a segmented choice.
component ChoiceRow inherits VerticalLayout {
    in property <string> text;

    padding: 12px;
    spacing: 10px;

    Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.font-body;
    }
    @children
}

// A group of rows under a heading.
component Group inherits VerticalLayout {
    in property <string> title;

    spacing: 8px;

    SectionTitle {
        text: root.title;
    }
    Card {
        height: rows.preferred-height;

        rows := VerticalLayout {
            padding: 6px;
            @children
        }
    }
}

// Only real settings live here; reference and info pages are in the menu of the project list. Groups
// hold uniform rows, and anything bigger gets a sub-page behind a `NavRow`.
export component SettingsPage inherits Rectangle {
    VerticalLayout {
        TopBar {
            title: @tr("Settings");
            back => { Store.back(); }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;
            content-y <=> SettingsScroll.y;

            content := VerticalLayout {
                padding: Theme.padding;
                padding-top: 4px;
                spacing: Theme.spacing + 4px;
                alignment: start;

                Group {
                    title: @tr("General");

                    ChoiceRow {
                        text: @tr("Language");
                        Segmented {
                            options: [{ label: @tr("System") }, { label: "Deutsch" }, { label: "English" }];
                            selected: Store.language == Language.de ? 1 : Store.language == Language.en ? 2 : 0;
                            select(index) => {
                                Store.set-language(index == 1 ? Language.de : index == 2 ? Language.en : Language.system);
                            }
                        }
                    }
                    Divider { }
                    ChoiceRow {
                        text: @tr("Appearance");
                        Segmented {
                            options: [{ label: @tr("System") }, { label: @tr("Light") }, { label: @tr("Dark") }];
                            selected: Store.appearance == Appearance.light ? 1 : Store.appearance == Appearance.dark ? 2 : 0;
                            select(index) => {
                                Store.set-appearance(index == 1 ? Appearance.light : index == 2 ? Appearance.dark : Appearance.system);
                            }
                        }
                    }
                }

                Group {
                    title: @tr("Counting");

                    SwitchRow {
                        text: @tr("Keep screen on");
                        description: @tr("While a project or pattern is open");
                        checked: Store.keep-screen-on;
                        toggled => { Store.set-keep-screen-on(!Store.keep-screen-on); }
                    }
                    Divider { }
                    SwitchRow {
                        text: @tr("Count with volume keys");
                        description: @tr("Volume up counts a row, volume down goes back");
                        checked: Store.volume-keys;
                        toggled => { Store.set-volume-keys(!Store.volume-keys); }
                    }
                }

                Group {
                    title: @tr("Yarn");

                    ChoiceRow {
                        text: @tr("Count yarn in");
                        Segmented {
                            options: [{ label: @tr("Skeins") }, { label: @tr("Grams") }];
                            selected: Store.yarn-in-grams ? 1 : 0;
                            select(index) => { Store.set-yarn-in-grams(index == 1); }
                        }
                    }
                }

                Group {
                    title: @tr("Pattern");

                    ChoiceRow {
                        text: @tr("Reading line color");
                        HorizontalLayout {
                            alignment: space-between;
                            for option in [
                                { value: LineColor.magenta, label: @tr("Magenta") },
                                { value: LineColor.red, label: @tr("Red") },
                                { value: LineColor.orange, label: @tr("Orange") },
                                { value: LineColor.blue, label: @tr("Blue") },
                                { value: LineColor.green, label: @tr("Green") },
                            ]: ColorSwatch {
                                value: option.value;
                                label: option.label;
                                selected: Store.line-color == option.value;
                                select => { Store.set-line-color(option.value); }
                            }
                        }
                    }
                }

                Group {
                    title: @tr("Data");

                    NavRow {
                        text: @tr("Backup");
                        detail: @tr("ZIP file");
                        clicked => { Store.open-page(Screen.backup); }
                    }
                }
            }
        }
    }
}

// Settings → Data → Backup: export and import everything as a ZIP file.
export component BackupPage inherits Rectangle {
    VerticalLayout {
        TopBar {
            title: @tr("Backup");
            back => { Store.back(); }
        }

        VerticalLayout {
            vertical-stretch: 1;
            padding: Theme.padding;
            padding-top: 4px;
            alignment: start;

            Card {
                height: backup.preferred-height;

                backup := VerticalLayout {
                    padding: 18px;
                    spacing: 14px;

                    Text {
                        text: @tr("Save projects, row counters, patterns, yarns and hooks as a ZIP file, for example before switching phones.");
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        PillButton {
                            text: @tr("Export");
                            kind: ButtonKind.secondary;
                            horizontal-stretch: 1;
                            enabled: !Store.backup-busy;
                            clicked => { Store.export-backup(); }
                        }
                        PillButton {
                            text: @tr("Import");
                            kind: ButtonKind.secondary;
                            horizontal-stretch: 1;
                            enabled: !Store.backup-busy;
                            clicked => { Store.import-backup(); }
                        }
                    }
                }
            }
        }
    }
}
