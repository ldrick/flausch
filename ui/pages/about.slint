import { AboutSlint } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Store, Screen } from "../store.slint";
import { ButtonKind, Card, Divider, Icon, NavRow, PillButton, TopBar } from "../components.slint";

// "Made with ♥ in the Black Forest", with a red heart.
component MadeWithLove inherits HorizontalLayout {
    alignment: center;
    spacing: 6px;
    accessible-role: text;
    accessible-label: @tr("Made with love in the Black Forest");

    Text {
        text: @tr("Made with");
        color: Theme.text-muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        Icon {
            source: @image-url("../icons/heart.svg");
            color: Theme.heart;
            width: 18px;
            height: 18px;
        }
    }
    Text {
        text: @tr("in the Black Forest");
        color: Theme.text-muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
}

// ⋮ → About: the app, its changes, donating and the website.
export component InfoPage inherits Rectangle {
    VerticalLayout {
        TopBar {
            title: @tr("About");
            back => { Store.back(); }
        }

        VerticalLayout {
            vertical-stretch: 1;
            padding: Theme.padding;
            padding-top: 4px;
            alignment: start;

            Card {
                height: rows.preferred-height;

                rows := VerticalLayout {
                    padding: 6px;

                    NavRow {
                        text: @tr("About Flausch");
                        detail: Store.version;
                        clicked => { Store.open-page(Screen.about); }
                    }
                    Divider { }
                    NavRow {
                        text: @tr("Changelog");
                        clicked => { Store.open-page(Screen.changelog); }
                    }
                    Divider { }
                    NavRow {
                        text: @tr("Donate");
                        clicked => { Store.open-page(Screen.donate); }
                    }
                    Divider { }
                    NavRow {
                        text: @tr("Website");
                        detail: "ldrick.github.io/flausch";
                        clicked => { Store.open-url("https://ldrick.github.io/flausch/"); }
                    }
                }
            }
        }
    }
}

export component AboutPage inherits Rectangle {
    VerticalLayout {
        TopBar {
            title: @tr("About Flausch");
            back => { Store.back(); }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;

            content := VerticalLayout {
                padding: Theme.padding;
                padding-top: 4px;
                spacing: Theme.spacing;
                alignment: start;

                Card {
                    height: about.preferred-height;

                    about := VerticalLayout {
                        padding: 18px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            Text {
                                text: "Flausch";
                                color: Theme.accent;
                                font-family: Theme.font-logo;
                                font-size: 40px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "/flaʊʃ/";
                                color: Theme.text-muted;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                                accessible-role: none;
                            }
                            Text {
                                text: Store.version;
                                color: Theme.text-muted;
                                font-size: Theme.font-body;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: @tr("A crochet companion. Flausch is German for fluff and sounds like “fl”, then “ow” as in “now”, then “sh”.");
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                        MadeWithLove { }
                        Text {
                            text: @tr("Logo font: Montez by Astigmatic, Apache License 2.0");
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 120px;
                            background: Theme.surface-muted;
                            border-radius: Theme.radius-small;

                            AboutSlint { }
                        }
                    }
                }
            }
        }
    }
}

export component ChangelogPage inherits Rectangle {
    VerticalLayout {
        TopBar {
            title: @tr("Changelog");
            back => { Store.back(); }
        }

        changelog-flick := Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;

            content := VerticalLayout {
                padding: Theme.padding;
                padding-top: 4px;
                spacing: Theme.spacing;
                alignment: start;

                // The outer layout doesn't see the wrapped height of a repeated layout, so pin it.
                for change in Store.changes: Card {
                    height: entry.preferred-height;

                    entry := VerticalLayout {
                        padding: 18px;
                        spacing: 6px;

                        Text {
                            text: @tr("Version {}", change.version);
                            color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: 600;
                        }
                        for point in change.points: Rectangle {
                            height: row.preferred-height;

                            row := HorizontalLayout {
                                spacing: 8px;
                                accessible-role: text;
                                accessible-label: point;

                                Text {
                                    text: "•";
                                    color: Theme.accent;
                                    font-size: Theme.font-small;
                                }
                                Text {
                                    text: point;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component DonatePage inherits Rectangle {
    VerticalLayout {
        TopBar {
            title: @tr("Donate");
            back => { Store.back(); }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;

            content := VerticalLayout {
                padding: Theme.padding;
                padding-top: 4px;
                spacing: Theme.spacing;
                alignment: start;

                Card {
                    height: donate.preferred-height;

                    donate := VerticalLayout {
                        padding: 18px;
                        spacing: 14px;

                        Text {
                            text: "Flausch";
                            color: Theme.accent;
                            font-family: Theme.font-logo;
                            font-size: 56px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: @tr("I develop Flausch on my own, in my spare time, free and without ads or tracking. If it helps you with your projects, I would be happy if you bought me a coffee. Thank you!");
                            color: Theme.text;
                            font-size: Theme.font-body;
                            wrap: word-wrap;
                        }
                        PillButton {
                            text: "GitHub Sponsors";
                            clicked => { Store.open-url("https://github.com/sponsors/ldrick"); }
                        }
                        PillButton {
                            text: "Liberapay";
                            kind: ButtonKind.secondary;
                            clicked => { Store.open-url("https://liberapay.com/ldrick"); }
                        }
                        Text {
                            text: @tr("Opens the page in your browser.");
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        MadeWithLove { }
                    }
                }
            }
        }
    }
}
