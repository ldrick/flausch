import { AboutSlint, Palette } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Store } from "../store.slint";
import { ButtonKind, Card, Icon, PillButton, TopBar } from "../components.slint";

// "Made with ♥ in the Black Forest", with a red heart.
component MadeWithLove inherits HorizontalLayout {
    alignment: center;
    spacing: 6px;
    accessible-role: text;
    accessible-label: @tr("Made with love in the Black Forest");

    Text {
        text: @tr("Made with");
        color: Theme.text-muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        Icon {
            source: @image-url("../icons/heart.svg");
            color: Theme.heart;
            width: 18px;
            height: 18px;
        }
    }
    Text {
        text: @tr("in the Black Forest");
        color: Theme.text-muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
}

export component AboutPage inherits Rectangle {
    VerticalLayout {
        TopBar {
            title: @tr("About Flausch");
            back => { Store.back(); }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;

            content := VerticalLayout {
                padding: Theme.padding;
                padding-top: 4px;
                spacing: Theme.spacing;
                alignment: start;

                Card {
                    height: about.preferred-height;

                    about := VerticalLayout {
                        padding: 18px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 10px;
                            Icon {
                                source: @image-url("../icons/logo.svg");
                                color: Theme.accent;
                                width: 28px;
                                height: 28px;
                            }
                            Text {
                                text: "Flausch \{Store.version}";
                                color: Theme.text;
                                font-size: Theme.font-body;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: @tr("A crochet companion. Flausch is German for fluff.");
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            wrap: word-wrap;
                        }
                        MadeWithLove { }
                        // AboutSlint follows Palette, not Theme, so give it a matching backdrop.
                        Rectangle {
                            height: 120px;
                            background: Palette.background;
                            border-radius: Theme.radius-small;

                            AboutSlint { }
                        }
                    }
                }
            }
        }
    }
}

export component ChangelogPage inherits Rectangle {
    VerticalLayout {
        TopBar {
            title: @tr("Changelog");
            back => { Store.back(); }
        }

        changelog-flick := Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;

            content := VerticalLayout {
                padding: Theme.padding;
                padding-top: 4px;
                spacing: Theme.spacing;
                alignment: start;

                // The outer layout doesn't see the wrapped height of a repeated layout, so pin it.
                for change in Store.changes: Card {
                    height: entry.preferred-height;

                    entry := VerticalLayout {
                        padding: 18px;
                        spacing: 6px;

                        Text {
                            text: @tr("Version {}", change.version);
                            color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: 600;
                        }
                        for point in change.points: Rectangle {
                            height: row.preferred-height;

                            row := HorizontalLayout {
                                spacing: 8px;
                                accessible-role: text;
                                accessible-label: point;

                                Text {
                                    text: "•";
                                    color: Theme.accent;
                                    font-size: Theme.font-small;
                                }
                                Text {
                                    text: point;
                                    color: Theme.text-muted;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component DonatePage inherits Rectangle {
    VerticalLayout {
        TopBar {
            title: @tr("Donate");
            back => { Store.back(); }
        }

        Flickable {
            vertical-stretch: 1;
            content-height: content.preferred-height;

            content := VerticalLayout {
                padding: Theme.padding;
                padding-top: 4px;
                spacing: Theme.spacing;
                alignment: start;

                Card {
                    height: donate.preferred-height;

                    donate := VerticalLayout {
                        padding: 18px;
                        spacing: 14px;

                        HorizontalLayout {
                            alignment: center;
                            Icon {
                                source: @image-url("../icons/logo.svg");
                                color: Theme.accent;
                                width: 56px;
                                height: 56px;
                            }
                        }
                        Text {
                            text: @tr("I develop Flausch on my own, in my spare time, free and without ads or tracking. If it helps you with your projects, I would be happy if you bought me a coffee. Thank you!");
                            color: Theme.text;
                            font-size: Theme.font-body;
                            wrap: word-wrap;
                        }
                        PillButton {
                            text: "GitHub Sponsors";
                            clicked => { Store.open-url("https://github.com/sponsors/ldrick"); }
                        }
                        PillButton {
                            text: "Liberapay";
                            kind: ButtonKind.secondary;
                            clicked => { Store.open-url("https://liberapay.com/ldrick"); }
                        }
                        Text {
                            text: @tr("Opens the page in your browser.");
                            color: Theme.text-muted;
                            font-size: Theme.font-small;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        MadeWithLove { }
                    }
                }
            }
        }
    }
}
