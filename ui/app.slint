import { Palette } from "std-widgets.slint";
import { Theme, Appearance, LineColor } from "theme.slint";
import { Store, Screen, DialogKind, Notice, ProjectItem, PartItem, PdfView, Language, A11yFocus, ProjectStatus, StatusFilter, ProjectSort, ChangeItem, PartForm } from "store.slint";
import { Dialog, DialogButtons, Field, IconButton, Keyboard, PillButton, ButtonKind, TextArea } from "components.slint";
import { ListPage } from "pages/list.slint";
import { ProjectPage } from "pages/project.slint";
import { PartPage } from "pages/part.slint";
import { PdfPage } from "pages/pdf.slint";
import { SettingsPage } from "pages/settings.slint";
import { AboutPage, ChangelogPage, DonatePage } from "pages/about.slint";

export { Store, Theme, Appearance, LineColor, Screen, DialogKind, Notice, ProjectItem, PartItem, PdfView, Language, A11yFocus, ProjectStatus, StatusFilter, ProjectSort, ChangeItem, PartForm }

component SortDialog inherits Dialog {
    callback done();

    title: @tr("Sort by");
    dismissed => { root.done(); }

    VerticalLayout {
        spacing: 4px;

        for option in [
            { sort: ProjectSort.recent, label: @tr("Last used") },
            { sort: ProjectSort.name, label: @tr("Name") },
            { sort: ProjectSort.newest, label: @tr("Newest") },
            { sort: ProjectSort.progress, label: @tr("Progress") },
            { sort: ProjectSort.custom, label: @tr("Custom") },
        ]: row := Rectangle {
            property <bool> selected: option.sort == Store.project-sort;
            height: 56px;
            border-radius: Theme.radius-small;
            background: self.selected ? Theme.accent-soft : touch.pressed ? Theme.surface-muted : transparent;
            accessible-role: button;
            accessible-label: option.label;
            accessible-checked: self.selected;
            accessible-action-default => { touch.clicked(); }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                Text {
                    text: option.label;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: row.selected ? 600 : 400;
                    vertical-alignment: center;
                }
            }
            touch := TouchArea {
                clicked => {
                    Store.set-project-sort(option.sort);
                    root.done();
                }
            }
        }
        Text {
            text: @tr("Hold a project to move it.");
            color: Theme.text-muted;
            font-size: Theme.font-small;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

component ProjectDialog inherits Dialog {
    in property <bool> editing;
    callback done();

    title: root.editing ? @tr("Rename project") : @tr("New project");
    dismissed => { root.done(); }

    function submit() {
        if name.text.is-empty {
            return;
        }
        if root.editing {
            Store.edit-project(name.text);
        } else {
            Store.create-project(name.text);
        }
        root.done();
    }

    init => {
        if root.editing {
            name.text = Store.current.name;
        }
        name.focus-input();
    }

    name := Field {
        label: @tr("Name");
        placeholder: @tr("Name, e.g. Bunny");
        accepted => { root.submit(); }
    }
    DialogButtons {
        confirm-text: root.editing ? @tr("Save") : @tr("Create");
        confirm-enabled: !name.text.is-empty;
        cancel => { root.done(); }
        confirm => { root.submit(); }
    }
}

component PartDialog inherits Dialog {
    in property <bool> editing;
    callback done();

    title: root.editing ? @tr("Edit part") : @tr("New part");
    dismissed => { root.done(); }

    function submit() {
        if name.text.is-empty {
            return;
        }
        let form = {
            name: name.text,
            rows: goal.text,
            quantity: quantity.text,
        };
        if root.editing {
            Store.edit-part(Store.edited.id, form);
        } else {
            Store.add-part(form);
        }
        root.done();
    }

    init => {
        if root.editing {
            name.text = Store.edited.name;
            goal.text = Store.edited.goal > 0 ? Store.edited.goal : "";
            quantity.text = Store.edited.quantity > 1 ? Store.edited.quantity : "";
        }
        name.focus-input();
    }

    name := Field {
        label: @tr("Name");
        placeholder: @tr("Name, e.g. Head");
        accepted => { goal.focus-input(); }
    }
    goal := Field {
        label: @tr("Rows (optional)");
        placeholder: @tr("Rows (optional)");
        input-type: InputType.number;
        accepted => { quantity.focus-input(); }
    }
    quantity := Field {
        label: @tr("How many (optional)");
        placeholder: @tr("How many, e.g. 4 legs");
        input-type: InputType.number;
        accepted => { root.submit(); }
    }
    HorizontalLayout {
        if root.editing: VerticalLayout {
            alignment: end;
            IconButton {
                icon: @image-url("icons/trash.svg");
                tint: Theme.danger;
                label: @tr("Delete part");
                clicked => { Store.dialog = DialogKind.delete-part; }
            }
        }
        DialogButtons {
            horizontal-stretch: 1;
            confirm-text: root.editing ? @tr("Save") : @tr("Add");
            confirm-enabled: !name.text.is-empty;
            cancel => { root.done(); }
            confirm => { root.submit(); }
        }
    }
}

component NotesDialog inherits Dialog {
    callback done();

    title: @tr("Notes");
    dismissed => { root.done(); }

    init => {
        notes.text = Store.current.notes;
        notes.focus-input();
    }

    notes := TextArea {
        label: @tr("Notes");
        placeholder: @tr("Yarn, hook size, changes…");
    }
    DialogButtons {
        confirm-text: @tr("Save");
        cancel => { root.done(); }
        confirm => {
            Store.set-notes(notes.text);
            root.done();
        }
    }
}

export component App inherits Window {
    title: "Flausch";
    preferred-width: 412px;
    preferred-height: 924px;
    background: Theme.background;

    property <DialogKind> dialog: Store.dialog;
    property <Screen> screen: Store.screen;
    property <Appearance> appearance: Store.appearance;
    property <bool> dark: Theme.dark;
    property <bool> back-handled;
    property <bool> palette-forced;
    property <ColorScheme> system-scheme;
    property <bool> searching: Store.searching;
    property <length> keyboard-height: self.virtual-keyboard-size.height > 0 ? max(0, self.height - self.virtual-keyboard-position.y) : 0;
    changed keyboard-height => {
        Keyboard.height = self.keyboard-height;
    }
    changed searching => {
        if !self.searching {
            scope.focus();
        }
    }
    changed dialog => {
        if self.dialog == DialogKind.none {
            scope.focus();
        }
    }
    changed screen => {
        scope.focus();
    }
    init => {
        scope.focus();
        Theme.appearance = Store.appearance;
    }
    changed appearance => {
        Theme.appearance = self.appearance;
        // Widgets from std-widgets (AboutSlint) follow Palette, so it follows the appearance setting, too. Remember
        // the system scheme before overriding it the first time, so "System" can go back to it.
        if !self.palette-forced {
            self.system-scheme = Palette.color-scheme;
            self.palette-forced = true;
        }
        Palette.color-scheme = self.appearance == Appearance.light ? ColorScheme.light : self.appearance == Appearance.dark ? ColorScheme.dark : self.system-scheme;
    }
    changed dark => {
        Store.dark-changed(self.dark);
    }

    function close-dialog() {
        Store.dialog = DialogKind.none;
    }

    scope := FocusScope {

        // Android's back button and Escape on the desktop: close a dialog, then go back.
        // The logic, including dropping duplicate Back events, lives in Rust (`Controller::back`).
        capture-key-pressed(event) => {
            if event.text == Key.Back || event.text == Key.Escape {
                root.back-handled = Store.back();
                return root.back-handled ? accept : reject;
            }
            reject
        }
        // Keep press and release symmetric: only an unhandled Back may close the app.
        capture-key-released(event) => {
            if event.text == Key.Back || event.text == Key.Escape {
                return root.back-handled ? accept : reject;
            }
            reject
        }

        // Pages stay clear of the status and navigation bars; dialogs cover the whole window.
        Rectangle {
            x: root.safe-area-insets.left;
            y: root.safe-area-insets.top;
            width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
            height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;

            if Store.screen == Screen.list: ListPage { }
            if Store.screen == Screen.project: ProjectPage { }
            if Store.screen == Screen.part: PartPage { }
            if Store.screen == Screen.pdf: PdfPage { }
            if Store.screen == Screen.settings: SettingsPage { }
            if Store.screen == Screen.about: AboutPage { }
            if Store.screen == Screen.changelog: ChangelogPage { }
            if Store.screen == Screen.donate: DonatePage { }

            if Store.notice != Notice.none: Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 96px;
                width: min(parent.width - 40px, 380px);
                height: notice-text.preferred-height + 32px;
                border-radius: Theme.radius;
                background: Theme.text;

                notice-text := Text {
                    x: 20px;
                    width: parent.width - 40px;
                    text: Store.notice == Notice.pdf-invalid ? @tr("This file could not be opened as a PDF.")
                        : Store.notice == Notice.pdf-render-failed ? @tr("The page could not be displayed.")
                        : Store.notice == Notice.backup-saved ? @tr("Backup saved.")
                        : Store.notice == Notice.backup-save-failed ? @tr("The backup could not be saved.")
                        : Store.notice == Notice.backup-import-failed ? @tr("The file could not be read.")
                        : Store.notice == Notice.backup-invalid ? @tr("This file is not a Flausch backup.")
                        : Store.notice == Notice.backup-too-new ? @tr("This backup is from a newer version of Flausch. Please update the app first.")
                        : Store.notice == Notice.backup-restored ? @tr("Backup restored.")
                        : Store.notice == Notice.backup-restore-failed ? @tr("The backup could not be restored. Your data is unchanged.")
                        : @tr("The PDF could not be imported.");
                    color: Theme.background;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                    accessible-live-region: polite;
                }
                TouchArea {
                    clicked => { Store.dismiss-notice(); }
                }
                Timer {
                    interval: 4s;
                    triggered => { Store.dismiss-notice(); }
                }
            }
        }

        if Store.dialog == DialogKind.create || Store.dialog == DialogKind.edit: ProjectDialog {
            editing: Store.dialog == DialogKind.edit;
            done => { root.close-dialog(); }
        }

        if Store.dialog == DialogKind.delete: Dialog {
            title: @tr("Delete project?");
            message: @tr("“{}” and its pattern will be removed. This cannot be undone.", Store.current.name);
            dismissed => { root.close-dialog(); }

            DialogButtons {
                confirm-text: @tr("Delete");
                destructive: true;
                cancel => { root.close-dialog(); }
                confirm => {
                    root.close-dialog();
                    Store.delete-project();
                }
            }
        }

        if Store.dialog == DialogKind.add-part || Store.dialog == DialogKind.edit-part: PartDialog {
            editing: Store.dialog == DialogKind.edit-part;
            done => { root.close-dialog(); }
        }

        if Store.dialog == DialogKind.notes: NotesDialog {
            done => { root.close-dialog(); }
        }

        if Store.dialog == DialogKind.incoming-pdf: Dialog {
            title: @tr("Open PDF");
            message: Store.has-projects ? @tr("Create a new project with “{}” or add it to a project.", Store.incoming-title)
                : @tr("Create a new project with “{}”.", Store.incoming-title);
            dismissed => { Store.discard-incoming(); }

            if Store.has-projects: Flickable {
                height: min(targets.preferred-height, 280px);
                content-height: targets.preferred-height;

                targets := VerticalLayout {
                    alignment: start;
                    spacing: 4px;

                    for project in Store.projects: Rectangle {
                        height: 56px;
                        border-radius: Theme.radius-small;
                        background: target-touch.pressed ? Theme.surface-muted : transparent;
                        accessible-role: button;
                        accessible-label: project.name;
                        accessible-description: project.has-pdf ? @tr("Replaces its pattern") : "";
                        accessible-action-default => { Store.incoming-to-project(project.id); }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;

                            Text {
                                text: project.name;
                                color: Theme.text;
                                font-size: Theme.font-body;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if project.has-pdf: Text {
                                text: @tr("Replaces its pattern");
                                color: Theme.text-muted;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                            }
                        }
                        target-touch := TouchArea {
                            clicked => { Store.incoming-to-project(project.id); }
                        }
                    }
                }
            }
            DialogButtons {
                confirm-text: @tr("New project");
                cancel => { Store.discard-incoming(); }
                confirm => { Store.incoming-to-new-project(); }
            }
        }

        if Store.dialog == DialogKind.delete-part: Dialog {
            title: @tr("Delete part?");
            message: @tr("“{}” and its row counter will be removed.", Store.edited.name);
            dismissed => { root.close-dialog(); }

            DialogButtons {
                confirm-text: @tr("Delete");
                destructive: true;
                cancel => { root.close-dialog(); }
                confirm => {
                    root.close-dialog();
                    Store.delete-part(Store.edited.id);
                }
            }
        }

        if Store.dialog == DialogKind.pick-part: Dialog {
            title: @tr("Choose part");
            dismissed => { root.close-dialog(); }

            Flickable {
                height: min(parts.preferred-height, 336px);
                content-height: parts.preferred-height;

                parts := VerticalLayout {
                    alignment: start;
                    spacing: 4px;

                    for part in Store.parts: Rectangle {
                        property <bool> active: Store.current.has-active && part.id == Store.current.active.id;
                        height: 56px;
                        border-radius: Theme.radius-small;
                        background: self.active ? Theme.accent-soft : part-touch.pressed ? Theme.surface-muted : transparent;
                        accessible-role: button;
                        accessible-label: part.title;
                        accessible-checked: self.active;
                        accessible-action-default => {
                            Store.select-part(part.id);
                            root.close-dialog();
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;

                            Text {
                                text: part.title;
                                color: Theme.text;
                                font-size: Theme.font-body;
                                font-weight: Store.current.has-active && part.id == Store.current.active.id ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: part.goal > 0 ? @tr("Row {} of {}", part.row, part.goal) : @tr("Row {}", part.row);
                                color: Theme.text-muted;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                            }
                        }
                        part-touch := TouchArea {
                            clicked => {
                                Store.select-part(part.id);
                                root.close-dialog();
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                PillButton {
                    text: @tr("Cancel");
                    kind: ButtonKind.quiet;
                    clicked => { root.close-dialog(); }
                }
            }
        }

        if Store.dialog == DialogKind.sort: SortDialog {
            done => { root.close-dialog(); }
        }

        if Store.dialog == DialogKind.reset: Dialog {
            title: @tr("Reset counter?");
            message: Store.part.quantity > 1 ? @tr("The row counter of “{}” goes back to 0, starting again with the first piece.", Store.part.name)
                : @tr("The row counter of “{}” goes back to 0.", Store.part.name);
            dismissed => { root.close-dialog(); }

            DialogButtons {
                confirm-text: @tr("Reset");
                cancel => { root.close-dialog(); }
                confirm => {
                    root.close-dialog();
                    Store.reset();
                }
            }
        }

        if Store.dialog == DialogKind.remove-pdf: Dialog {
            title: @tr("Remove pattern?");
            message: @tr("The PDF is removed from this project. The row counters stay.");
            dismissed => { root.close-dialog(); }

            DialogButtons {
                confirm-text: @tr("Remove");
                destructive: true;
                cancel => { root.close-dialog(); }
                confirm => {
                    root.close-dialog();
                    Store.remove-pdf();
                }
            }
        }

        if Store.dialog == DialogKind.restore-backup: Dialog {
            title: @tr("Restore backup?");
            message: @tr("The backup contains {n} project. It replaces all projects and settings on this device. This cannot be undone." | "The backup contains {n} projects. It replaces all projects and settings on this device. This cannot be undone." % Store.backup-projects);
            dismissed => { root.close-dialog(); }

            DialogButtons {
                confirm-text: @tr("Restore");
                destructive: true;
                cancel => { root.close-dialog(); }
                confirm => {
                    root.close-dialog();
                    Store.restore-backup();
                }
            }
        }
    }

    // Android can't draw TalkBack's focus frame over the native surface, so we draw it here.
    if Store.a11y-focus.visible: Rectangle {
        x: Store.a11y-focus.x - 2px;
        y: Store.a11y-focus.y - 2px;
        width: Store.a11y-focus.width + 4px;
        height: Store.a11y-focus.height + 4px;
        border-width: 3px;
        border-radius: min(self.height / 2, 24px);
        border-color: Theme.a11y-focus;
    }
}
