import { Theme } from "theme.slint";
import { Store } from "store.slint";

export component Icon inherits Image {
    in property <color> color: Theme.text;
    width: 24px;
    height: 24px;
    colorize: root.color;
    image-fit: contain;
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.text;
    in property <bool> enabled: true;
    in property <string> label;
    callback clicked();

    width: Theme.touch;
    height: Theme.touch;
    border-radius: self.height / 2;
    background: touch.pressed ? Theme.surface-muted : transparent;
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Icon {
        source: root.icon;
        color: root.tint;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export enum ButtonKind { primary, secondary, quiet }

export component PillButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <ButtonKind> kind: ButtonKind.primary;
    in property <bool> enabled: true;
    // Compact, e.g. in a top bar.
    in property <bool> small;
    callback clicked();

    height: root.small ? 40px : Theme.touch + 4px;
    min-width: root.small ? 0 : 96px;
    horizontal-stretch: 0;
    border-radius: self.height / 2;
    background: {
        if root.kind == ButtonKind.primary { return touch.pressed ? Theme.accent-pressed : Theme.accent; }
        if root.kind == ButtonKind.secondary { return touch.pressed ? Theme.surface-muted : Theme.surface; }
        return touch.pressed ? Theme.surface-muted : transparent;
    }
    border-width: root.kind == ButtonKind.secondary ? 1px : 0;
    border-color: Theme.border;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    property <color> content-color: root.kind == ButtonKind.primary ? Theme.on-accent : root.kind == ButtonKind.quiet ? Theme.accent-pressed : Theme.text;

    HorizontalLayout {
        padding-left: root.small ? 16px : 22px;
        padding-right: root.small ? 16px : 22px;
        spacing: 8px;
        alignment: center;

        if root.has-icon: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                color: root.content-color;
                width: 20px;
                height: 20px;
            }
        }
        Text {
            text: root.text;
            color: root.content-color;
            font-size: Theme.font-body;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius;
    drop-shadow-offset-y: Theme.shadow-offset;
    drop-shadow-color: Theme.shadow;
}

export component ProgressBar inherits Rectangle {
    in property <float> progress;
    height: 6px;
    border-radius: self.height / 2;
    background: Theme.surface-muted;

    Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        border-radius: parent.border-radius;
        background: Theme.accent;
        animate width { duration: Theme.animation; easing: ease-out; }
    }
}

export component Field inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    // Shows the label above a filled-in value, so it stays clear what the value is.
    in property <bool> show-label: true;
    in-out property <string> text <=> input.text;
    out property <bool> has-focus: input.has-focus;
    callback accepted();

    property <bool> label-shown: root.show-label && input.text != "";

    public function focus-input() {
        input.focus();
        // Cursor at the end, no select-all: the keyboard's Enter would replace a selection.
        input.set-selection-offsets(2147483647, 2147483647);
        Store.hide-text-handles();
    }

    height: 56px;
    border-radius: Theme.radius-small;
    background: Theme.surface-muted;
    border-width: input.has-focus ? 1.5px : 0;
    border-color: Theme.accent;

    Text {
        x: 16px;
        accessible-role: none;
        width: parent.width - 32px;
        height: parent.height;
        visible: input.text == "";
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: Theme.font-body;
        vertical-alignment: center;
    }

    if root.label-shown: Text {
        x: 16px;
        y: 7px;
        width: parent.width - 32px;
        accessible-role: none;
        text: root.label;
        color: input.has-focus ? Theme.accent-pressed : Theme.text-muted;
        font-size: Theme.font-small - 1px;
        overflow: elide;
    }

    input := TextInput {
        x: 16px;
        y: root.label-shown ? 12px : 0;
        width: parent.width - 32px;
        height: parent.height - self.y;
        single-line: true;
        input-type: root.input-type;
        color: Theme.text;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.on-accent;
        font-size: Theme.font-body;
        vertical-alignment: center;
        accessible-label: root.label;
        accessible-placeholder-text: root.placeholder;
        accepted => { root.accepted(); }
    }
}

// Multi-line text field that scrolls with the cursor.
export component TextArea inherits Rectangle {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text <=> input.text;

    public function focus-input() {
        input.focus();
        Store.hide-text-handles();
    }

    height: 200px;
    border-radius: Theme.radius-small;
    background: Theme.surface-muted;
    border-width: input.has-focus ? 1.5px : 0;
    border-color: Theme.accent;

    Text {
        x: 16px;
        y: 14px;
        width: parent.width - 32px;
        accessible-role: none;
        visible: input.text == "";
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: Theme.font-body;
        wrap: word-wrap;
    }

    flick := Flickable {
        x: 16px;
        y: 14px;
        width: parent.width - 32px;
        height: parent.height - 28px;
        content-height: input.height;

        input := TextInput {
            width: flick.width;
            height: max(flick.height, self.preferred-height);
            single-line: false;
            wrap: word-wrap;
            color: Theme.text;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.on-accent;
            font-size: Theme.font-body;
            accessible-label: root.label;
            accessible-placeholder-text: root.placeholder;
            // Keep the cursor line visible.
            cursor-position-changed(position) => {
                if position.y + flick.content-y < 0 {
                    flick.content-y = -position.y;
                } else if position.y + flick.content-y > flick.height - Theme.font-body * 1.5 {
                    flick.content-y = flick.height - Theme.font-body * 1.5 - position.y;
                }
            }
        }
    }
}

export struct SegmentOption {
    label: string,
}

export component Segmented inherits Rectangle {
    in property <[SegmentOption]> options;
    in property <int> selected;
    callback select(int);

    height: 44px;
    border-radius: self.height / 2;
    background: Theme.surface-muted;

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        for option[index] in root.options: Rectangle {
            border-radius: self.height / 2;
            background: index == root.selected ? Theme.surface : transparent;
            drop-shadow-offset-y: index == root.selected ? Theme.shadow-offset-small : 0;
            drop-shadow-color: Theme.shadow;
            accessible-role: button;
            accessible-label: option.label;
            accessible-checked: index == root.selected;
            accessible-action-default => { root.select(index); }
            animate background { duration: Theme.animation; }

            Text {
                text: option.label;
                color: index == root.selected ? Theme.text : Theme.text-muted;
                font-size: Theme.font-small + 1px;
                font-weight: index == root.selected ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { root.select(index); }
            }
        }
    }
}

// A filter chip.
export component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();

    border-radius: self.height / 2;
    background: root.selected ? Theme.accent : Theme.surface;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    animate background { duration: Theme.animation; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.label;
            color: root.selected ? Theme.on-accent : Theme.text-muted;
            font-size: Theme.font-small + 1px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// A row of filter chips that scrolls sideways when it doesn't fit.
export component Chips inherits Flickable {
    in property <[SegmentOption]> options;
    in property <int> selected;
    callback select(int);

    height: 36px;
    content-width: row.preferred-width;
    content-height: self.height;

    row := HorizontalLayout {
        padding-left: Theme.padding;
        padding-right: Theme.padding;
        spacing: 8px;
        for option[index] in root.options: Chip {
            label: option.label;
            selected: index == root.selected;
            clicked => { root.select(index); }
        }
    }
}

// The color of a yarn as a small dot; `swatch` indexes `Theme.yarn-colors`.
export component SwatchDot inherits Rectangle {
    in property <int> swatch;
    width: 14px;
    height: self.width;
    border-radius: self.width / 2;
    background: Theme.yarn-colors[root.swatch];
    border-width: 1px;
    border-color: Theme.border;
}

// Suggestions under a field: chips that scroll sideways. A tap picks one.
export component Suggestions inherits Flickable {
    in property <[string]> items;
    callback pick(string);

    height: 36px;
    content-width: row.preferred-width;
    content-height: self.height;

    row := HorizontalLayout {
        spacing: 8px;
        for item in root.items: Rectangle {
            border-radius: self.height / 2;
            background: touch.pressed ? Theme.surface-muted : Theme.surface;
            border-width: 1px;
            border-color: Theme.border;
            accessible-role: button;
            accessible-label: @tr("Use {}", item);
            accessible-action-default => { root.pick(item); }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: item;
                    color: Theme.text;
                    font-size: Theme.font-small + 1px;
                    vertical-alignment: center;
                }
            }
            touch := TouchArea {
                clicked => { root.pick(item); }
            }
        }
    }
}

export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    callback toggled();

    width: 52px;
    height: 32px;
    border-radius: self.height / 2;
    background: root.checked ? Theme.accent : Theme.surface-muted;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checked: root.checked;
    accessible-action-default => { root.toggled(); }
    animate background { duration: Theme.animation; }

    Rectangle {
        width: 24px;
        height: 24px;
        y: 4px;
        x: root.checked ? parent.width - self.width - 4px : 4px;
        border-radius: self.height / 2;
        background: Theme.surface;
        drop-shadow-offset-y: Theme.shadow-offset-small;
        drop-shadow-color: Theme.shadow;
        animate x { duration: Theme.animation; easing: ease-out; }
    }
    TouchArea {
        clicked => { root.toggled(); }
    }
}

// An entry of a `TopMenu`. It closes the menu only if its `clicked` does, e.g. zoom stays open to repeat it.
export component MenuItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: Theme.touch + 4px;
    border-radius: Theme.radius-small - 4px;
    background: touch.pressed ? Theme.surface-muted : transparent;
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                width: 22px;
                height: 22px;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// The menu (⋮) of a top bar, dropping down from its button at the right. A tap outside or Back closes it;
// the items are its children.
export component TopMenu inherits TouchArea {
    // Distance of the menu from the top of the page.
    in property <length> top: 56px;

    clicked => { Store.menu-open = false; }

    Rectangle {
        x: parent.width - self.width - 8px;
        y: root.top;
        width: 240px;
        height: menu.preferred-height;
        background: Theme.surface;
        border-radius: Theme.radius-small;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-offset-y: Theme.shadow-offset-small;
        drop-shadow-color: Theme.shadow;
        // The TalkBack bridge (src/a11y.rs) only exposes what lies inside the menu.
        accessible-role: groupbox;
        accessible-id: "dialog";

        // Swallow taps between the items.
        TouchArea { }

        menu := VerticalLayout {
            padding: 6px;
            @children
        }
    }
}

// Height of the on-screen keyboard in window coordinates, 0 if hidden. Set by `App`.
export global Keyboard {
    in-out property <length> height;
}

// Modal sheet with a dimmed backdrop for short questions without text input. Tapping the backdrop
// dismisses it.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    callback dismissed();

    background: Theme.scrim;

    TouchArea {
        clicked => { root.dismissed(); }
    }

    card := Rectangle {
        width: min(root.width - 40px, 380px);
        // Scrolls if it doesn't fit, e.g. in landscape.
        height: min(layout.preferred-height, root.height - 64px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        background: Theme.surface;
        border-radius: Theme.radius-large;
        drop-shadow-offset-y: Theme.shadow-offset;
        drop-shadow-color: Theme.shadow;
        // The TalkBack bridge (src/a11y.rs) only exposes what lies inside this card.
        accessible-role: groupbox;
        accessible-id: "dialog";

        // Swallow taps so they don't reach the backdrop.
        TouchArea { }

        Flickable {
            content-height: layout.preferred-height;
            interactive: layout.preferred-height > self.height;

            layout := VerticalLayout {
                width: parent.width;
                padding: 24px;
                spacing: 16px;

                Text {
                    text: root.title;
                    color: Theme.text;
                    font-size: Theme.font-title;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                if root.message != "": Text {
                    text: root.message;
                    color: Theme.text-muted;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
                @children
            }
        }
    }
}

// Two buttons at the bottom of a dialog: dismiss and confirm.
export component DialogButtons inherits HorizontalLayout {
    // No confirm button if empty, e.g. for a list that acts on a tap.
    in property <string> confirm-text;
    in property <bool> confirm-enabled: true;
    callback cancel();
    callback confirm();

    spacing: 8px;
    alignment: end;
    padding-top: 8px;

    PillButton {
        text: @tr("Cancel");
        kind: ButtonKind.quiet;
        clicked => { root.cancel(); }
    }
    PillButton {
        text: root.confirm-text;
        kind: ButtonKind.primary;
        enabled: root.confirm-enabled;
        clicked => { root.confirm(); }
    }
}

// Top bar with an optional back button, a title and trailing actions as children.
export component TopBar inherits HorizontalLayout {
    in property <string> title;
    // Small line above the title, e.g. the project of a part.
    in property <string> subtitle;
    in property <bool> show-back: true;
    callback back();

    height: 64px;
    padding-left: root.show-back ? 4px : Theme.padding;
    padding-right: 8px;
    spacing: 4px;
    alignment: stretch;

    if root.show-back: VerticalLayout {
        alignment: center;
        IconButton {
            icon: @image-url("icons/chevron-left.svg");
            label: @tr("Back");
            clicked => { root.back(); }
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;

        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.text-muted;
            font-size: Theme.font-small;
            overflow: elide;
        }
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-title;
            font-weight: 600;
            overflow: elide;
        }
    }
    @children
}

// Full-screen form for text input (project name, part, notes): Back discards, the small button at the top
// right confirms. The fields scroll above the on-screen keyboard; Slint keeps the focused one in view.
export component Sheet inherits Rectangle {
    in property <string> title;
    // What is being edited, e.g. the project of a part.
    in property <string> subtitle;
    // No confirm button if empty, e.g. for a list that acts on a tap.
    in property <string> confirm-text;
    in property <bool> confirm-enabled: true;
    // Shows a delete button in the top bar.
    in property <string> delete-label;
    // Distance from the sheet's bottom edge to the bottom of the window (the navigation bar), which the
    // keyboard covers, too.
    in property <length> bottom-inset;
    // Visible height for the fields.
    out property <length> body-height: body.height - 2 * Theme.padding;
    callback cancel();
    callback confirm();
    callback delete();

    background: Theme.background;
    // The TalkBack bridge (src/a11y.rs) only exposes what lies inside the sheet.
    accessible-role: groupbox;
    accessible-id: "dialog";

    // Swallow taps so they don't reach the page below.
    TouchArea { }

    VerticalLayout {
        TopBar {
            title: root.title;
            subtitle: root.subtitle;
            padding-right: 16px;
            back => { root.cancel(); }

            if root.delete-label != "": VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("icons/trash.svg");
                    label: root.delete-label;
                    clicked => { root.delete(); }
                }
            }
            if root.confirm-text != "": VerticalLayout {
                alignment: center;
                PillButton {
                    small: true;
                    text: root.confirm-text;
                    enabled: root.confirm-enabled;
                    clicked => { root.confirm(); }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;

            body := Flickable {
                y: 0;
                height: parent.height - max(0, Keyboard.height - root.bottom-inset);
                content-height: max(self.height, fields.preferred-height);
                interactive: fields.preferred-height > self.height;

                fields := VerticalLayout {
                    // Narrow enough to read in landscape.
                    width: min(parent.width, 600px);
                    x: (parent.width - self.width) / 2;
                    padding: Theme.padding;
                    spacing: 16px;
                    alignment: start;
                    @children
                }
            }
        }
    }
}

// Small heading above a group of rows.
export component SectionTitle inherits Text {
    color: Theme.text-muted;
    font-size: Theme.font-small;
    font-weight: 600;
}

// An entry that opens a sub-page.
export component NavRow inherits Rectangle {
    in property <string> text;
    // Small text on the right, e.g. the version.
    in property <string> detail;
    callback clicked();

    height: Theme.touch + 8px;
    border-radius: Theme.radius-small;
    background: touch.pressed ? Theme.surface-muted : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 8px;

        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.detail;
            color: Theme.text-muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("icons/chevron-right.svg");
                color: Theme.text-muted;
                width: 20px;
                height: 20px;
            }
        }
    }
}

// A thin line between the rows of a card.
export component Divider inherits Rectangle {
    height: 1px;

    Rectangle {
        x: 12px;
        width: parent.width - 24px;
        background: Theme.border;
    }
}
