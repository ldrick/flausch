import { Appearance, LineColor } from "theme.slint";

export enum Screen { list, project, part, pdf, settings, about, changelog, donate, abbreviations, stash, hooks, info, backup }

export enum Language { system, de, en }

export enum DialogKind { none, create, edit, delete, notes, add-part, edit-part, delete-part, pick-part, sort, reset, remove-pdf, restore-backup, incoming-pdf, create-folder, edit-folder, pick-folder, add-yarn, edit-yarn, add-hook, edit-hook }

// One release in the changelog.
export struct ChangeItem {
    version: string,
    points: [string],
}

// A row of the abbreviation table. Abbreviations can be the word itself; several German ones are
// separated by commas.
export struct AbbreviationItem {
    de: string,
    de-name: string,
    us: string,
    us-name: string,
    uk: string,
    uk-name: string,
    // The UK abbreviation means something else than the US one (UK dc = US sc).
    uk-differs: bool,
}

export enum ProjectStatus { planned, active, paused, finished }
export enum StatusFilter { all, active, planned, paused, finished }
// Order within each status group of the project list.
export enum ProjectSort { recent, name, newest, progress, custom }

export enum Notice {
    none,
    pdf-import-failed,
    pdf-invalid,
    pdf-render-failed,
    backup-saved,
    backup-save-failed,
    backup-import-failed,
    backup-invalid,
    backup-too-new,
    backup-restored,
    backup-restore-failed,
    folder-deleted,
}

export struct PartItem {
    id: int,
    name: string,
    // The name, with "2/4" for a part made several times.
    title: string,
    row: int,
    // 0 means no goal.
    goal: int,
    // How many times the part is made, and the piece being worked on (from 1).
    quantity: int,
    piece: int,
    // The current piece is done and another one is left.
    can-next-piece: bool,
}

// The fields of the part dialog, as typed; empty optional fields mean none.
export struct PartForm {
    name: string,
    rows: string,
    quantity: string,
}

// The fields of the new project form.
export struct ProjectForm {
    name: string,
    status: ProjectStatus,
    notes: string,
}

// A folder on the project list.
export struct FolderItem {
    // 0 means no folder (the top level of the list).
    id: int,
    name: string,
    // Number of projects in it.
    count: int,
}

// The fields of the yarn form, as typed; empty number fields mean unknown.
export struct YarnForm {
    brand: string,
    name: string,
    color: string,
    dye-lot: string,
    fiber: string,
    // Grams and meters per skein.
    weight: string,
    length: string,
    // Skeins; empty counts as 1.
    quantity: string,
}

// A yarn in the stash.
export struct YarnItem {
    id: int,
    // Brand and yarn line; empty if neither is known.
    title: string,
    form: YarnForm,
    quantity: int,
    // Grams and meters per skein; 0 if unknown.
    weight: int,
    length: int,
}

// The fields of the hook form, as typed.
export struct HookForm {
    // Millimeters, with a point or a comma.
    size: string,
    brand: string,
    // The kind of hook, e.g. ergonomic or Tunisian.
    kind: string,
}

// The US size of a hook, e.g. "E-4"; empty if it has none. Steel hooks (thread crochet) count
// their numbers the other way.
export struct UsHookSize {
    name: string,
    steel: bool,
}

// A crochet hook.
export struct HookItem {
    id: int,
    // Millimeters, formatted for the language, e.g. "3,5".
    size: string,
    us: UsHookSize,
    // Brand and kind; empty if neither is known.
    title: string,
    form: HookForm,
}

export struct ProjectItem {
    id: int,
    name: string,
    // The folder it is in; id 0 if none.
    folder: FolderItem,
    status: ProjectStatus,
    notes: string,
    part-count: int,
    // The part opened last; `has-active` is false if there is none.
    has-active: bool,
    active: PartItem,
    // Total progress over all parts with a goal; `rows-total` is 0 if no part has one.
    rows-done: int,
    rows-total: int,
    has-pdf: bool,
    pdf-title: string,
    // Thumbnail of the first PDF page.
    has-cover: bool,
    cover: image,
    // Index range of its status group in the list, where it can be dragged to.
    group-start: int,
    group-end: int,
}

export struct PdfView {
    page: int,
    page-count: int,
    zoom: float,
    scroll-x: float,
    scroll-y: float,
    image: image,
    // height / width of the current page
    aspect: float,
    loading: bool,
    // Incremented whenever a newly rendered page arrives.
    serial: int,
    // Reading line of the current page: position as a fraction of the page height.
    // `line-saved` is false if this page has no position yet.
    line-visible: bool,
    line-saved: bool,
    line: float,
}

// The element TalkBack has focused, in logical window coordinates (Android only).
export struct A11yFocus {
    visible: bool,
    x: length,
    y: length,
    width: length,
    height: length,
}

// The interface between Rust (src/lib.rs) and the UI. Rust sets the `in` properties and
// handles the callbacks.
export global Store {
    // Projects in the open folder (in all folders while searching) matching `query` and `status-filter`, grouped by status (active, then planned and
    // paused, then finished) and most recently used first within a group. Without a query and
    // with the filter "all", finished projects are in `finished` instead.
    in property <[ProjectItem]> projects;
    in property <[ProjectItem]> finished;
    // All folders, by name.
    in property <[FolderItem]> folders;
    // The folder open on the project list; id 0 at the top level.
    in property <FolderItem> folder;
    // The list shows the folder cards: at the top level and not searching.
    in property <bool> show-folders;
    // Projects the incoming PDF can go to: all but the finished ones, in every folder.
    in property <[ProjectItem]> incoming-projects;
    // The collapsed section with the finished projects is open.
    in-out property <bool> finished-open;
    in property <StatusFilter> status-filter: StatusFilter.all;
    in property <ProjectSort> project-sort: ProjectSort.recent;
    // For the search, in ProjectStatus order.
    out property <[string]> status-names: [@tr("Planned"), @tr("In progress"), @tr("Paused"), @tr("Finished")];
    // Whether there are any projects at all, regardless of `query`.
    in property <bool> has-projects;
    in-out property <bool> searching;
    in-out property <string> query;
    in property <ProjectItem> current;
    // Parts of the current project, in the order they were added.
    in property <[PartItem]> parts;
    // The part shown on the part screen; same as `current.active`.
    in property <PartItem> part;
    // Title of the PDF picked in the new project form; empty if none.
    in property <string> new-pdf-title;
    // Parts added in the new project form.
    in property <[PartForm]> new-parts;
    // The part the edit and delete dialogs act on; set before opening them.
    in-out property <PartItem> edited;
    in property <Screen> screen: Screen.list;
    in property <PdfView> pdf: { zoom: 1, aspect: 1.414 };
    in property <Notice> notice: Notice.none;
    in property <A11yFocus> a11y-focus;
    // The yarn stash by brand, yarn line and color.
    in property <[YarnItem]> yarns;
    // Skeins in the stash, and the grams of those whose weight is known.
    in property <int> yarn-skeins;
    in property <int> yarn-grams;
    // The yarn the edit form acts on; set before opening it.
    in-out property <YarnItem> edited-yarn;
    // The hooks from the smallest.
    in property <[HookItem]> hooks;
    // The hook the edit form acts on; set before opening it.
    in-out property <HookItem> edited-hook;
    in property <string> version;
    // The changelog, newest release first, in the current language.
    in property <[ChangeItem]> changes;
    // The abbreviation table, filtered by `abbreviation-query`.
    in property <[AbbreviationItem]> abbreviations;
    in-out property <string> abbreviation-query;

    in property <Language> language: Language.system;
    in property <Appearance> appearance: Appearance.system;
    in property <bool> keep-screen-on: true;
    in property <LineColor> line-color: LineColor.magenta;
    in property <bool> volume-keys;
    // A backup is being written, chosen or restored.
    in property <bool> backup-busy;
    // Number of projects in the backup the restore dialog asks about.
    in property <int> backup-projects;
    // File name of a PDF opened or shared from another app, waiting for a project.
    in property <string> incoming-title;

    in-out property <DialogKind> dialog: DialogKind.none;
    // The PDF view shows the large counter instead of the floating one.
    in-out property <bool> counter-expanded;
    // The menu (⋮) in the top bar of the current page is open.
    in-out property <bool> menu-open;

    // Returns false if there is nothing to go back to.
    callback back() -> bool;
    callback open-settings();
    // A sub-page of the settings, e.g. about or changelog.
    callback open-page(Screen);
    callback abbreviation-query-changed();
    // Opens a web page in the browser.
    callback open-url(string);
    callback open-project(int);
    callback create-project(ProjectForm);
    callback edit-project(string);
    callback delete-project();
    callback set-status(ProjectStatus);
    callback set-notes(string);

    // Shows a folder on the project list; 0 goes back to the top level.
    callback open-folder(int);
    // Creates a folder and opens it.
    callback create-folder(string);
    // Rename and delete act on the open folder. Deleting keeps its projects.
    callback rename-folder(string);
    callback delete-folder();
    // Puts a project into a folder (dropped on it on the list, or chosen on the project screen); 0 takes it out.
    callback move-to-folder(int /* project */, int /* folder */);

    callback query-changed();
    callback set-status-filter(StatusFilter);
    callback set-project-sort(ProjectSort);
    // Moves a project `by` places in the shown list (within its status group) and switches to the
    // custom order.
    callback move-project(int /* id */, int /* by */);
    // Labels of the TalkBack actions on project cards.
    out property <string> move-up-label: @tr("Move up");
    out property <string> move-down-label: @tr("Move down");

    // Makes a part active without leaving the screen.
    callback select-part(int);
    // Opens the PDF view counting the part, or the part screen if the project has no PDF.
    callback open-part(int);
    // Opens the pattern of a project from the project list, at the saved page.
    callback continue-project(int);
    callback add-part(PartForm);
    callback edit-part(int, PartForm);
    callback delete-part(int);

    callback add-yarn(YarnForm);
    callback edit-yarn(int, YarnForm);
    callback delete-yarn(int);

    callback add-hook(HookForm);
    callback edit-hook(int, HookForm);
    callback delete-hook(int);
    // The US size for a size in millimeters as typed in the hook form.
    pure callback us-hook-size(string) -> UsHookSize;
    // Whether the hook form takes a size in millimeters as typed.
    pure callback valid-hook-size(string) -> bool;

    // The counter callbacks act on the active part.
    callback increment();
    callback decrement();
    callback reset();
    // Counts the current piece of the active part as done and starts the next one.
    callback next-piece();

    callback pick-pdf();
    // The PDF for the new project form; it is kept until the project is created or the form closes.
    callback pick-new-pdf();
    callback discard-new-pdf();
    callback add-new-part(PartForm);
    callback remove-new-part(int);
    // Drops the PDF and the parts of the new project form.
    callback discard-new-project();
    callback remove-pdf();
    callback open-pdf();
    // page, zoom, scroll-x, scroll-y, width of the page view in physical pixels
    callback pdf-view-changed(int, float, float, float, float);
    // visible, position for a page without a saved line (fraction of the page height)
    callback pdf-line-shown(bool, float);
    // new position on the current page (fraction of the page height)
    callback pdf-line-moved(float);

    callback dismiss-notice();
    callback set-language(Language);
    callback set-appearance(Appearance);
    callback set-keep-screen-on(bool);
    callback set-line-color(LineColor);
    callback set-volume-keys(bool);
    callback export-backup();
    // Lets the user choose a backup, then opens the restore dialog.
    callback import-backup();
    // Replaces all data with the chosen backup.
    callback restore-backup();
    // What to do with the incoming PDF: a new project, the pattern of a project, or nothing.
    callback incoming-to-new-project();
    callback incoming-to-project(int);
    callback discard-incoming();
    // A text field was focused from code (not by a tap); hides Android's cursor handles.
    callback hide-text-handles();
    // The effective theme changed (setting or system), for the system bar icons.
    callback dark-changed(bool);
}
