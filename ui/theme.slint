import { Palette } from "std-widgets.slint";

export enum Appearance { system, light, dark }

export enum LineColor { magenta, red, orange, blue, green }

// Soft, light and minimal. All colors, sizes and radii live here so the look can be changed in
// one place. Components use `Theme`, never `Palette` directly.
export global Theme {
    in-out property <Appearance> appearance: Appearance.system;
    out property <bool> dark: appearance == Appearance.system ? Palette.color-scheme == ColorScheme.dark : appearance == Appearance.dark;

    out property <color> background: dark ? #1b1618 : #f8f3f4;
    out property <color> surface: dark ? #251f22 : #ffffff;
    out property <color> surface-muted: dark ? #312a2d : #f3eaed;
    out property <color> border: dark ? #3d3438 : #eadfe3;
    out property <color> text: dark ? #eee4e8 : #3b3034;
    out property <color> text-muted: dark ? #a6969c : #9c8c92;
    out property <color> accent: dark ? #f2a7bc : #e3879f;
    out property <color> accent-pressed: dark ? #e292a9 : #d27390;
    out property <color> accent-soft: dark ? #44262f : #fbe7ed;
    // Frame around the element TalkBack has focused; has to stand out on every surface.
    out property <color> a11y-focus: dark ? #ffd54f : #1a5fd0;
    out property <color> on-accent: dark ? #33121c : #ffffff;
    // Text selection. On Android Slint also draws the text cursor in this color, so it needs contrast.
    out property <color> selection: accent;
    out property <color> danger: dark ? #f0877e : #c4473f;
    out property <color> scrim: dark ? #000000a0 : #3b303466;
    out property <color> shadow: dark ? #00000060 : #3b30341a;
    // Hard drop shadows: no blur, only offset downwards (drop-shadow-blur stays 0 everywhere).
    out property <length> shadow-offset: 6px;
    out property <length> shadow-offset-small: 2px;

    out property <length> radius-small: 12px;
    out property <length> radius: 20px;
    out property <length> radius-large: 28px;
    out property <length> spacing: 12px;
    out property <length> padding: 20px;
    out property <length> touch: 48px;

    out property <length> font-small: 13px;
    out property <length> font-body: 16px;
    out property <length> font-title: 22px;
    out property <length> font-headline: 30px;
    out property <length> font-counter: 112px;

    out property <duration> animation: 180ms;

    // Reading line in the PDF view. It is drawn on the page, so the colors don't follow `dark`.
    out property <length> line-width: 3px;
    out property <color> on-line: #ffffff;
    public pure function line-color(color: LineColor) -> color {
        if color == LineColor.red {
            return #e53935;
        } else if color == LineColor.orange {
            return #f57c00;
        } else if color == LineColor.blue {
            return #1e88e5;
        } else if color == LineColor.green {
            return #2e9d4f;
        }
        return #e6007e;
    }
}
